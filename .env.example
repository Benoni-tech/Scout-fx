# Firebase (client — safe to expose, NEXT_PUBLIC_*)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only — from your service account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend
RESEND_API_KEY=

# Public site URL (used in ticket emails and QR codes; no trailing slash)
NEXT_PUBLIC_SITE_URL=https://scoutsfx.com

# Comma-separated emails allowed into /admin (each needs a Firebase Auth
# email/password account created in the Firebase console)
ADMIN_EMAILS=
